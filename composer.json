{
  "name": "k2gl/sd-jwt-vc",
  "description": "SD-JWT-based Verifiable Credentials (SD-JWT VC) in pure PHP: issue and verify dc+sd-jwt credentials",
  "homepage": "https://github.com/k2gl/sd-jwt-vc",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "sd-jwt-vc",
    "sd-jwt",
    "verifiable-credentials",
    "digital-credentials",
    "eudi",
    "openid4vc",
    "haip",
    "selective-disclosure",
    "jwt",
    "identity"
  ],
  "authors": [
    {
      "name": "Nick Harin",
      "email": "l0gic@ya.ru"
    }
  ],
  "support": {
    "issues": "https://github.com/k2gl/sd-jwt-vc/issues",
    "source": "https://github.com/k2gl/sd-jwt-vc"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "k2gl/sd-jwt": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1|^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10|^11|^12",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "~1.20.0",
    "k2gl/phpunit-fluent-assertions": "^12",
    "nyholm/psr7": "^1.8",
    "k2gl/composer-attest": "^1.1",
    "k2gl/composer-license-gate": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "k2gl/composer-attest": true,
      "k2gl/composer-license-gate": true
    }
  },
  "extra": {
    "k2gl-attest": {
      "mode": "warn"
    },
    "k2gl-license-gate": {
      "mode": "warn",
      "allow": ["MIT", "BSD-2-Clause", "BSD-3-Clause", "Apache-2.0", "ISC"]
    }
  },
  "suggest": {
    "ext-openssl": "Required for ES256/RS256 signing and x5c certificate chain validation.",
    "ext-sodium": "Required for EdDSA signing and verification."
  },
  "autoload": {
    "psr-4": {
      "K2gl\\SdJwtVc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "K2gl\\SdJwtVc\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs": "pint --test",
    "cs-fix": "pint",
    "check": [
      "@test",
      "@phpstan",
      "@cs"
    ]
  }
}
